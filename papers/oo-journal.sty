\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{oo-journal}[2026/11/26 Academic working-paper layout]
\RequirePackage[letterpaper,hmargin=.85in,vmargin=.75in]{geometry}
\RequirePackage{lmodern,xcolor}
\hypersetup{colorlinks=true,urlcolor=blue!45!black,citecolor=black,linkcolor=black}
\setlength{\emergencystretch}{2em}
\AtBeginDocument{%
  \setlength{\abovedisplayskip}{8pt plus 2pt minus 3pt}%
  \setlength{\belowdisplayskip}{8pt plus 2pt minus 3pt}}
\raggedbottom
\pagestyle{plain}

% Keep editorial responsibility distinct from formal authorship in print and metadata.
\newcommand{\ooshorttitle}[1]{\hypersetup{pdfsubject={#1}}}
\newcommand{\ooprojectcredit}[1]{\def\ooProjectCredit{#1}}
\ooprojectcredit{}
\renewcommand{\@maketitle}{%
  \begin{center}
    {\LARGE\@title\par}
    \vskip .85em
    {\small\ooProjectCredit\par}
    \vskip .48em
    {\small\@date\par}
  \end{center}
  \vskip .4em}
